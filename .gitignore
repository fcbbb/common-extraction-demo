# -----------------------------------------------------------------------------
# Generated experiment artifacts
# -----------------------------------------------------------------------------
# Raw API responses, refactored trees, test traces, and historical trials can
# be regenerated and may contain large payloads.  Track only curated summaries.
demo/results/*
!demo/results/codecontest/
demo/results/codecontest/*
!demo/results/codecontest/EXPERIMENT_REPORT.md
!demo/results/codecontest/full_recompute_summary.json
!demo/results/libcloud_loadbalancer_real/
demo/results/libcloud_loadbalancer_real/*
!demo/results/libcloud_loadbalancer_real/EXPERIMENT_REPORT.md
!demo/results/libcloud_loadbalancer_real/full_pool_comparison.json
!demo/results/libcloud_loadbalancer_real/embedding_recall_summary.json

# Keep one current human-facing report; older generated reports remain local.
demo/reports/*
!demo/reports/final_report_signal.md
